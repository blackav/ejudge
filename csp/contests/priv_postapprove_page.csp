<div id="UserReviewEditedRenderedMdDiv">
<h2>Review for user (edited)</h2>

<div id="UserReviewEditedContentDiv"></div>

<div><button id="EditEditedMdButton"></button><button id="RevertEditedMdButton"></button></div>

</div>

<div id="UserReviewEditMdDiv">
<h2>Edit markdown</h2>
<textarea id="UserReviewEditTextarea" cols="80" rows="24">
</textarea>
<div><button id="EditorSaveButton"></button><button id="EditorCancelButton"></button><button id="EditorRevertButton"></button></div>
</div>

<script language="javascript">
function CancelEditing() {
    $("#UserReviewEditMdDiv").hide();
    $("#UserReviewEditTextarea").val("");
    if (user_review_edited_md === undefined) {
        $("#UserReviewOriginalRenderedMdDiv").show();
    } else {
        $("#UserReviewEditedRenderedMdDiv").show();
    }
}

$(function() {
    $("#UserReviewEditedRenderedMdDiv").hide();
    $("#UserReviewEditMdDiv").hide();

    $("#EditOriginalMdButton").button({
        label: "Edit"
    });
    $("#EditOriginalMdButton").on("click", function() {
        $("#UserReviewOriginalRenderedMdDiv").hide();
        $("#UserReviewEditTextarea").val(user_review_original_md);
        $("#UserReviewEditMdDiv").show();
    });

    $("#EditorSaveButton").button({
        label: "Save"
    });
    $("#EditorSaveButton").on("click", function() {
        const newtext = $("#UserReviewEditTextarea").val();
        if (newtext === undefined || newtext === null || newtext === "" || newtext === user_review_original_md) {
            $("#UserReviewEditMdDiv").hide();
            $("#UserReviewEditTextarea").val("");
            $("#UserReviewOriginalRenderedMdDiv").show();
            user_review_edited_md = undefined;
        } else {
            $("#UserReviewEditMdDiv").hide();
            $("#UserReviewEditTextarea").val("");

            $.ajax({
                type: "POST",
                url: self_url,
                data: {
                    SID: SID,
                    action: "render-markdown",
                    markdown: newtext,
                },
                contentType: "application/x-www-form-urlencoded; charset=utf-8",
                dataType: "json",
                success: function(data) {
                    if (data.ok) {
                        if (data.result && data.result.html) {
                            user_review_edited_md = newtext;
                            $("#UserReviewEditedContentDiv").html(data.result.html);
                            $("#UserReviewEditedRenderedMdDiv").show();
                        } else {
                            alert("invalid response from server");
                            CancelEditing();
                        }
                    } else {
                        if (data.error && data.error.message) {
                            alert(data.error.message + ", log_id: " + data.error.log_id);
                        } else {
                            alert("request failed");
                        }
                        CancelEditing();
                    }
                },
                error: function(data) {
                    if (data.responseJSON && data.responseJSON.error && data.responseJSON.error.message) {
                        alert(data.responseJSON.error.message + ", log_id: " + data.responseJSON.error.log_id);
                    } else {
                        alert("request failed");
                    }
                    CancelEditing();
                }
            });
        }
    });

    $("#EditorCancelButton").button({
        label: "Cancel"
    });
    $("#EditorCancelButton").on("click", function() {
        CancelEditing();
    });
    $("#EditorRevertButton").button({
        label: "Discard all edits"
    });
    $("#EditorRevertButton").on("click", function() {
        $("#UserReviewEditMdDiv").hide();
        $("#UserReviewEditTextarea").val("");
        user_review_edited_md = undefined;
        $("#UserReviewOriginalRenderedMdDiv").show();
    });

    $("#EditEditedMdButton").button({
        label: "Edit"
    });
    $("#EditEditedMdButton").on("click", function() {
        $("#UserReviewEditedRenderedMdDiv").hide();
        $("#UserReviewEditTextarea").val(user_review_edited_md);
        $("#UserReviewEditMdDiv").show();
    });
    $("#RevertEditedMdButton").button({
        label: "Discard all edits"
    });
    $("#RevertEditedMdButton").on("click", function() {
        $("#UserReviewEditedRenderedMdDiv").hide();
        user_review_edited_md = undefined;
        $("#UserReviewOriginalRenderedMdDiv").show();
    });
});
</script>

<%
    if (pg->prr->review_judge_result && pg->prr->review_judge_result[0]) {
