%>
<script language="javascript">
var user_review_original_md = "<s:v json="1" value="pg->prr->review_result" />";
var user_review_edited_md = undefined;
var SID="<s:v value="phr->session_id" />";
var self_url="<s:v value="phr->self_url" escape="false" />";
</script>

<div id="UserReviewOriginalRenderedMdDiv">
<h2>Review for user</h2>
<%
            fwrite_unlocked(md_review1.data, 1, md_review1.size, out_f);
%>
