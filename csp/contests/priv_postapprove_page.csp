<h2>Problem statement</h2>

<%
    struct md_content *pmd = NULL;
    if (prob && prob->variant_num > 0 && pg->variant > 0 && prob->md_size > 0 && pg->variant <= prob->md_size) {
        pmd = &prob->md_files[pg->variant - 1];
    } else if (prob && prob->variant_num <= 0 && pg->variant <= 0 && prob->md_size == 1) {
        pmd = &prob->md_files[0];
    }

    if (pmd && pmd->data) {
        putc_unlocked('\n', out_f);
        ns_unparse_md_statement(out_f, phr, prob, pg->variant, pmd->data);
        putc_unlocked('\n', out_f);
    }
%>

