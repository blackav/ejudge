        <td class="b0"><button id="CancelToListButton"></button></td>
        <td class="b0"><button id="CancelToMainButton"></button></td>
    </tr>
</table>

<script language="javascript">
function gotoMain() {
    document.location.href = self_url + "?SID=" + SID + "&action=main-page";
}
function gotoList() {
    document.location.href = self_url + "?SID=" + SID + "&action=reviews-page&mode=2";
}
function handleNext(next) {
    if (next === "List") {
        gotoList();
        return;
    }
    if (next === "Main") {
        gotoMain();
        return;
    }
    serial_id = <s:v value="pg->prr->serial_id" />;
    $.ajax({
        type: "GET",
        url: self_url + "?SID=" + SID + "&action=list-reviews-json&json=1&contest_ids=*&date_mode=1&list_mode=2&count=1&serial_id_gt=" + serial_id,
        dataType: "json",
        success: function(data) {
            if (!data.ok || !data.result || !data.result.reviews || !data.result.reviews.length) {
                gotoList();
                return;
            }
            window.location.href = self_url + '?SID=' + SID + "&action=postapprove-page&serial_id=" + data.result.reviews[0].serial_id;
        },
        error: function(data) {
            gotoList();
        },
    });
}
function handleButton(operation, next) {
    var query = {
        serial_id: <s:v value="pg->prr->serial_id" />,
        SID: SID,
        action: "postapprove-json",
        operation: operation,
    };
    if (user_review_edited_md !== undefined && user_review_edited_md !== null && user_review_edited_md !== "") {
        query["approved_text"] = user_review_edited_md;
    }
    $.ajax({
        type: "POST",
        url: self_url,
        data: query,
        contentType: "application/x-www-form-urlencoded; charset=utf-8",
        dataType: "json",
        success: function(data) {
            if (data.ok) {
                handleNext(next);
            } else {
                if (data.error && data.error.message) {
                    alert(data.error.message + ", log_id: " + data.error.log_id);
                } else {
                    alert("request failed");
                }
            }
        },
        error: function(data) {
            if (data.responseJSON && data.responseJSON.error && data.responseJSON.error.message) {
                alert(data.responseJSON.error.message + ", log_id: " + data.responseJSON.error.log_id);
            } else {
                alert("request failed");
            }
        }
    });
}

function registerOnClick(id, operation, next) {
    $(id).on("click", function() {
        handleButton(operation, next);
    });
}

$(function() {
    const o1 = {
        "Skip" : {
            "Label": "Skip ⏩",
            "Operation": 1,
        },
        "Reject" : {
            "Label": "Reject 👎",
            "Operation": 2,
        },
        "Ignore" : {
            "Label": "Ignore 🗑️",
            "Operation": 3,
        },
        "Approve" : {
            "Label": "Approve ✅",
            "Operation": 4,
        },
        "Disqualify" : {
            "Label": "Disqualify 🟥",
            "Operation": 5,
        },
        "Summon" : {
            "Label": "Summon 🗣️",
            "Operation": 6,
        },
        "Rereview" : {
            "Label": "Re-Review 🧐",
            "Operation": 7,
        },
        "Cancel" : {
            "Label": "Cancel ❌",
            "Operation": 8,
        },
    };
    const o2 = {
        "Next" : {
            "Label": "Next ⏭️",
        },
        "List" : {
            "Label": "List 📜",
        },
        "Main" : {
            "Label": "Main 🏠",
        },
    };
    for (r in o1) {
        for (c in o2) {
            const id = "#" + r + "To" + c + "Button";
            $(id).button({
                label: o1[r].Label + " to " + o2[c].Label,
            }).width(180).height(35);
            registerOnClick(id, o1[r].Operation, c);
        }
    }
});
</script>

<table class="b0"><tr>
<td class="b0"><s:a ac="main-page"><s:_>Main page</s:_></s:a></td>
</tr></table>

