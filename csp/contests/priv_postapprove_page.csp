<%
%><%@include "priv_includes.csp"
%><%
// includes

%><%@set getter_name = "csp_get_priv_postapprove_page"
%><%@set ac_prefix = "NEW_SRV_ACTION_"
%><%@page csp_view_priv_postapprove_page(PageInterface *pg, FILE *log_f, FILE *out_f, struct http_request_info *phr)
%><%@include "priv_stdvars.csp"
%><%
    const unsigned char *title = "Approve reviews";
    int enable_main_menu = 0;
#define ENABLE_TABULATOR 1
%><%@include "priv_header_jq.csp"
%>
</div>

<table class="b0"><tr>
<td class="b0"><s:a ac="main-page"><s:_>Main page</s:_></s:a></td>
</tr></table>

<h2>Reviews</h2>

<div id="ReviewsTable"></div>

<!--
serial_id
creation_time
review_uuid
contest_id
run_id
status
purpose
last_update_time
generation
-->
<script language="javascript">
  var SID="<s:v value="phr->session_id" />";
  var self_url="<s:v value="phr->self_url" escape="false" />";
  var list_review_json_ac = <s:ac ac="list-reviews-json" />;
</script>

<script type="text/javascript">
$(function() {
    var table = new Tabulator("#ReviewsTable", {
		ajaxURL: self_url,
		ajaxParams: {
			SID: SID,
			action: "list-reviews-json",
			json: 1,
			contest_ids: "*",
		},
		ajaxResponse: function(url, params, response) {
			if (response.ok) {
				return response.result.reviews;
			}
			return [];
		},
 		layout:"fitColumns", //fit columns to width of table (optional)
 		columns:[
	 		{title:"ID", field:"serial_id", width:60},
	 		{title:"Contest ID", field:"contest_id", width:60},
	 		{title:"Run ID", field:"run_id", width:60},
	 		{title:"Generation", field:"generation", width:60},
	 		{title:"Purpose", field:"purpose", width:100},
	 		{title:"Status", field:"status", width:100},
		],
	});
    table.on("rowClick", function(e, row){ 
	    alert("Row " + row.getData().id + " Clicked!!!!");
    });
});
</script>

<table class="b0"><tr>
<td class="b0"><s:a ac="main-page"><s:_>Main page</s:_></s:a></td>
</tr></table>

<%@include "priv_footer.csp"
%><%
cleanup:
    (void) &&cleanup;
    l10n_resetlocale();
    html_armor_free(&ab);
%>
