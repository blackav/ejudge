#!/bin/bash
# Copyright (c) 2004-2026 Alexander Chernov <cher@ejudge.ru>

# assume that we have single argument
# EJUDGE_JAVA_FLAGS may be used to pass additional flags
# EJUDGE_JAVA_POLICY is the policy name
# EJUDGE_PREFIX_DIR is used to create the full path
# EJUDGE_JAVA_COMPILER is the compiler version (javac or javac7)

runfile="$1"
shift

CONFIG_FILE=javac
if [ "${EJUDGE_JAVA_COMPILER}" = "javac7" ]
then
  CONFIG_FILE=javac7
  EJUDGE_JAVA_FLAGS="-client ${EJUDGE_JAVA_FLAGS}"
fi

LANG_CONFIG_DIR="@lang_config_dir@"
[ "${EJUDGE_LANG_CONFIG}" = "" ] && EJUDGE_LANG_CONFIG="${LANG_CONFIG_DIR}/${CONFIG_FILE}.cfg"

if [ -f "${EJUDGE_LANG_CONFIG}" ]
then
  . "${EJUDGE_LANG_CONFIG}"
else
  JAVARUN="/usr/bin/java"
  JAVADIR="/usr"
  JAVAVER="1.6"
fi

# Check if this JAR is generated by scala
file1=s_${RANDOM}_${RANDOM}_${RANDOM}
file2=s_${RANDOM}_${RANDOM}_${RANDOM}
if unzip -c -q "${runfile}" META-INF/MANIFEST.MF > "${file1}"
then
    if grep Scala < "${file1}" > "${file2}"
    then
        # that's scala
        # FIXME: consider special options for scala
        rm -f "${file1}" "${file2}"
        F=${EJUDGE_JAVA_FLAGS//-X/-J-X}
        exec scala ${F} "${runfile}" "$@"
    fi
fi

exec "${JAVARUN}" ${EJUDGE_JAVA_FLAGS} ${EJUDGE_FLAGS} -jar "${runfile}" ${EJUDGE_FLAGS_2} "$@"
